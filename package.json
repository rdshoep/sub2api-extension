{
  "name": "sub2api-console",
  "displayName": "Sub2API Console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome/Edge MV3 side-panel console for multi-instance Sub2API operations",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "compile": "vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview": "wxt prepare"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "pinia": "3.0.3",
    "vue": "3.5.21",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "@wxt-dev/module-vue": "1.0.3",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-plugin-vue": "10.4.0",
    "globals": "16.3.0",
    "happy-dom": "18.0.1",
    "msw": "2.11.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.5",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.0.6",
    "wxt": "0.20.11"
  }
}
