{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sub2api.local/schemas/adapter-spec.schema.json",
  "title": "AdapterSpec",
  "type": "object",
  "required": ["id", "version", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "displayName": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "queries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "themePreset": { "type": "string" }
  }
}
